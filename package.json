{
  "name": "@devstroop/uikit",
  "private": true,
  "description": "Framework-agnostic UI kit for Devstroop app front-ends — spec + token tooling.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "tokens:validate": "node scripts/validate-theme.mjs",
    "tokens:generate": "node scripts/generate-css.mjs",
    "specs:validate": "node scripts/validate-specs.mjs",
    "parity:validate": "node scripts/validate-parity.mjs",
    "preview": "vite preview/react",
    "preview:build": "vite build preview/react",
    "preview:typecheck": "tsc -p preview/react/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.62.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "yaml": "^2.8.0"
  }
}
