{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devstroop/uikit theme token schema",
  "description": "Canonical token vocabulary for devstroop/uikit themes. Every theme file in themes/<name>/tokens.json must contain exactly these tiers and tokens. A value is either a plain string (theme-invariant) or an object { light, dark }. The --se- CSS prefix is implied: tier 'color' + token 'bg' emits --se-color-bg.",
  "tiers": {
    "color": {
      "kind": "color",
      "tokens": [
        "bg",
        "surface",
        "surface-hover",
        "border",
        "border-strong",
        "text",
        "text-muted",
        "primary",
        "primary-hover",
        "primary-fg",
        "danger",
        "danger-hover",
        "danger-fg",
        "success",
        "warning",
        "focus",
        "backdrop"
      ]
    },
    "radius": {
      "kind": "length",
      "tokens": [
        "sm",
        "md",
        "lg",
        "full"
      ]
    },
    "space": {
      "kind": "length",
      "tokens": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    },
    "font": {
      "kind": "font",
      "tokens": [
        "sans",
        "size-xs",
        "size-sm",
        "size-md",
        "size-lg",
        "weight-regular",
        "weight-medium",
        "weight-bold"
      ]
    },
    "shadow": {
      "kind": "shadow",
      "tokens": [
        "sm",
        "md",
        "lg"
      ]
    },
    "transition": {
      "kind": "duration",
      "tokens": [
        "fast",
        "base",
        "slow"
      ]
    },
    "ease": {
      "kind": "easing",
      "tokens": [
        "out"
      ]
    },
    "z": {
      "kind": "integer",
      "tokens": [
        "tooltip",
        "popover",
        "modal",
        "toast"
      ]
    },
    "control": {
      "kind": "length",
      "tokens": [
        "height"
      ]
    }
  },
  "contrastRules": [
    {
      "fg": "text",
      "bg": "bg",
      "min": 4.5
    },
    {
      "fg": "text-muted",
      "bg": "bg",
      "min": 4.5
    },
    {
      "fg": "text",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "primary-fg",
      "bg": "primary",
      "min": 4.5
    },
    {
      "fg": "danger-fg",
      "bg": "danger",
      "min": 4.5
    }
  ]
}