      "fast": "120ms ease",
      "base": "200ms ease",
      "slow": "300ms ease"
    },
    "ease": {
      "out": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "z": {
      "tooltip": "1000",
      "popover": "1500",
      "modal": "2000",
      "toast": "3000"
