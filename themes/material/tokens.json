{
  "$schema": "../../specs/tokens.schema.json",
  "name": "material",
  "description": "Google Material Design 2 palette (purple primary, teal secondary family). Fills follow M2 color roles; primary/danger fg flipped to pass WCAG AA text-on-fill (4.5).",
  "values": {
    "color": {
      "bg": { "light": "#ffffff", "dark": "#121212" },
      "surface": { "light": "#ffffff", "dark": "#121212" },
      "surface-hover": { "light": "#f5f5f5", "dark": "#1e1e1e" },
      "border": { "light": "#e0e0e0", "dark": "#383838" },
      "border-strong": { "light": "#bdbdbd", "dark": "#5a5a5a" },
      "text": { "light": "#212121", "dark": "#e0e0e0" },
      "text-muted": { "light": "#757575", "dark": "#9e9e9e" },
      "primary": { "light": "#6200ee", "dark": "#bb86fc" },
      "primary-hover": { "light": "#3700b3", "dark": "#a377f1" },
      "primary-fg": { "light": "#ffffff", "dark": "#000000" },
      "danger": { "light": "#b00020", "dark": "#cf6679" },
      "danger-hover": { "light": "#8f001e", "dark": "#c25b6f" },
      "danger-fg": { "light": "#ffffff", "dark": "#000000" },
      "success": { "light": "#2e7d32", "dark": "#81c995" },
      "warning": { "light": "#f9a825", "dark": "#f2cc60" },
      "focus": { "light": "rgba(98, 0, 238, 0.4)", "dark": "rgba(187, 134, 252, 0.4)" },
      "backdrop": { "light": "rgba(0, 0, 0, 0.32)", "dark": "rgba(0, 0, 0, 0.6)" }
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "full": "9999px"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px"
    },
    "font": {
      "sans": "Roboto, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "size-xs": "12px",
      "size-sm": "14px",
      "size-md": "16px",
      "size-lg": "20px",
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-bold": "700"
    },
    "shadow": {
      "sm": {
        "light": "0 1px 5px rgba(0, 0, 0, 0.2), 0 2px 2px rgba(0, 0, 0, 0.14), 0 3px 1px -2px rgba(0, 0, 0, 0.12)",
        "dark": "0 1px 5px rgba(0, 0, 0, 0.6), 0 2px 2px rgba(0, 0, 0, 0.5), 0 3px 1px -2px rgba(0, 0, 0, 0.4)"
      },
      "md": {
        "light": "0 2px 4px -1px rgba(0, 0, 0, 0.2), 0 4px 5px 0 rgba(0, 0, 0, 0.14), 0 1px 10px 0 rgba(0, 0, 0, 0.12)",
        "dark": "0 2px 4px -1px rgba(0, 0, 0, 0.6), 0 4px 5px 0 rgba(0, 0, 0, 0.5), 0 1px 10px 0 rgba(0, 0, 0, 0.4)"
      },
      "lg": {
        "light": "0 5px 5px -3px rgba(0, 0, 0, 0.2), 0 8px 10px 1px rgba(0, 0, 0, 0.14), 0 3px 14px 2px rgba(0, 0, 0, 0.12)",
        "dark": "0 5px 5px -3px rgba(0, 0, 0, 0.6), 0 8px 10px 1px rgba(0, 0, 0, 0.5), 0 3px 14px 2px rgba(0, 0, 0, 0.4)"
      }
    },
    "transition": {
      "fast": "120ms ease",
      "base": "200ms ease",
      "slow": "300ms ease"
    },
    "ease": {
      "out": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "z": {
      "tooltip": "1000",
      "popover": "1500",
      "modal": "2000",
      "toast": "3000"
    },
    "control": {
      "height": "36px"
    }
  }
}