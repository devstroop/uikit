      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "full": "9999px"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px"
    },
    "font": {
      "sans": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "size-xs": "12px",
      "size-sm": "14px",
      "size-md": "16px",
      "size-lg": "20px",
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-bold": "600",
      "size-xl": "24px"
    },
    "shadow": {
      "sm": {
        "light": "0 0 2px rgba(0, 0, 0, 0.12), 0 2px 4px rgba(0, 0, 0, 0.14)",
        "dark": "0 0 2px rgba(0, 0, 0, 0.8), 0 2px 4px rgba(0, 0, 0, 0.8)"
      },
      "md": {
        "light": "0 0 2px rgba(0, 0, 0, 0.12), 0 4px 8px rgba(0, 0, 0, 0.14), 0 8px 16px rgba(0, 0, 0, 0.14)",
        "dark": "0 0 2px rgba(0, 0, 0, 0.8), 0 4px 8px rgba(0, 0, 0, 0.8), 0 8px 16px rgba(0, 0, 0, 0.8)"
      },
      "lg": {
        "light": "0 0 2px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.14), 0 16px 32px rgba(0, 0, 0, 0.14)",
        "dark": "0 0 2px rgba(0, 0, 0, 0.8), 0 8px 16px rgba(0, 0, 0, 0.8), 0 16px 32px rgba(0, 0, 0, 0.8)"
      }
    },
    "transition": {
      "fast": "100ms ease",
      "base": "150ms ease",
      "slow": "250ms ease"
    },
    "ease": {
      "out": "cubic-bezier(0.1, 0.9, 0.2, 1)"
    },
    "z": {
      "tooltip": "1000",
      "popover": "1500",
      "modal": "2000",
      "toast": "3000"
    },
    "control": {
      "height": "32px",
      "height-xs": "16px",
      "height-sm": "24px",
      "height-md": "32px",
      "height-lg": "40px",
      "height-xl": "48px"
    },
    "motion": {
      "shimmer": "1.6s",
      "sweep": "1.4s"
    }
