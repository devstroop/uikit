{
  "$schema": "../../specs/tokens.schema.json",
  "name": "github",
  "description": "GitHub Primer design system (light default + dark). Buttons follow the Primer emphasis scale; danger and primary fills tuned to pass WCAG AA text-on-fill (4.5).",
  "values": {
    "color": {
      "bg": {
        "light": "#ffffff",
        "dark": "#0d1117"
      },
      "surface": {
        "light": "#ffffff",
        "dark": "#0d1117"
      },
      "surface-hover": {
        "light": "#f6f8fa",
        "dark": "#161b22"
      },
      "border": {
        "light": "#d1d9e0",
        "dark": "#30363d"
      },
      "border-strong": {
        "light": "#89929d",
        "dark": "#8b949e"
      },
      "text": {
        "light": "#1f2328",
        "dark": "#e6edf3"
      },
      "text-muted": {
        "light": "#59636e",
        "dark": "#8d96a0"
      },
      "primary": {
        "light": "#1f883d",
        "dark": "#238636"
      },
      "primary-hover": {
        "light": "#1a7f37",
        "dark": "#1f883d"
      },
      "primary-fg": {
        "light": "#ffffff",
        "dark": "#ffffff"
      },
      "danger": {
        "light": "#cf222e",
        "dark": "#da3633"
      },
      "danger-hover": {
        "light": "#b62324",
        "dark": "#b62324"
      },
      "danger-fg": {
        "light": "#ffffff",
        "dark": "#ffffff"
      },
      "success": {
        "light": "#1a7f37",
        "dark": "#3fb950"
      },
      "warning": {
        "light": "#9a6700",
        "dark": "#d29922"
      },
      "focus": {
        "light": "rgba(9, 105, 218, 0.3)",
        "dark": "rgba(56, 139, 253, 0.4)"
      },
      "backdrop": {
        "light": "rgba(31, 35, 40, 0.5)",
        "dark": "rgba(1, 4, 9, 0.8)"
      },
      "text-primary": {
        "light": "#1b7736",
        "dark": "#289a3e"
      },
      "text-success": {
        "light": "#197b35",
        "dark": "#3fb950"
      },
      "text-warning": {
        "light": "#906000",
        "dark": "#d29922"
      },
      "text-danger": {
        "light": "#cb212d",
        "dark": "#df5451"
      },
      "palette-0": {
        "light": "#2563eb",
        "dark": "#4177ee"
      },
      "palette-1": {
        "light": "#7c3aed",
        "dark": "#955ff0"
      },
      "palette-2": {
        "light": "#04825b",
        "dark": "#059669"
      },
      "palette-3": {
        "light": "#b16105",
        "dark": "#d97706"
      },
      "palette-4": {
        "light": "#dc2626",
        "dark": "#e14545"
      },
      "palette-5": {
        "light": "#0b7caf",
        "dark": "#0ea5e9"
      }
    },
    "radius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "full": "999px"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px"
    },
    "font": {
      "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
      "size-xs": "12px",
      "size-sm": "14px",
      "size-md": "16px",
      "size-lg": "20px",
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-bold": "600"
    },
    "shadow": {
      "sm": {
        "light": "0 1px 0 rgba(31, 35, 40, 0.04)",
        "dark": "0 1px 0 rgba(255, 255, 255, 0.03)"
      },
      "md": {
        "light": "0 3px 6px rgba(140, 149, 159, 0.15)",
        "dark": "0 3px 6px rgba(0, 0, 0, 0.57)"
      },
      "lg": {
        "light": "0 8px 24px rgba(140, 149, 159, 0.2)",
        "dark": "0 8px 24px rgba(0, 0, 0, 0.6)"
      }
    },
    "transition": {
      "fast": "80ms ease",
      "base": "160ms ease",
      "slow": "320ms ease"
    },
    "ease": {
      "out": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "z": {
      "tooltip": "1000",
      "popover": "1500",
      "modal": "2000",
      "toast": "3000"
    },
    "control": {
      "height": "32px"
    },
    "motion": {
      "shimmer": "1.6s",
      "sweep": "1.4s"
    }
  }
}
