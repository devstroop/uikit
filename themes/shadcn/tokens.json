{
  "$schema": "../../specs/tokens.schema.json",
  "name": "shadcn",
  "description": "shadcn/ui neutral theme (Tailwind/oklch source tokens converted to hex). Destructive fill darkened from #ef4444 to pass WCAG AA text-on-fill (4.5).",
  "values": {
    "color": {
      "bg": {
        "light": "#ffffff",
        "dark": "#020817"
      },
      "surface": {
        "light": "#ffffff",
        "dark": "#020817"
      },
      "surface-hover": {
        "light": "#f1f5f9",
        "dark": "#1e293b"
      },
      "border": {
        "light": "#e2e8f0",
        "dark": "#1e293b"
      },
      "border-strong": {
        "light": "#7a94b2",
        "dark": "#516178"
      },
      "text": {
        "light": "#020817",
        "dark": "#f8fafd"
      },
      "text-muted": {
        "light": "#475569",
        "dark": "#cbd5e1"
      },
      "primary": {
        "light": "#0f172a",
        "dark": "#f8fafd"
      },
      "primary-hover": {
        "light": "#1e293b",
        "dark": "#e2e8f0"
      },
      "primary-fg": {
        "light": "#f8fafd",
        "dark": "#020817"
      },
      "danger": {
        "light": "#dc2626",
        "dark": "#7f1d1d"
      },
      "danger-hover": {
        "light": "#b91c1c",
        "dark": "#991b1b"
      },
      "danger-fg": {
        "light": "#f8fafd",
        "dark": "#f8fafd"
      },
      "success": {
        "light": "#12843c",
        "dark": "#22c55e"
      },
      "warning": {
        "light": "#b16105",
        "dark": "#f59e0b"
      },
      "focus": {
        "light": "rgba(2, 8, 23, 0.35)",
        "dark": "rgba(248, 250, 253, 0.35)"
      },
      "backdrop": {
        "light": "rgba(0, 0, 0, 0.5)",
        "dark": "rgba(0, 0, 0, 0.6)"
      },
      "text-primary": {
        "light": "#0f172a",
        "dark": "#f3f6fc"
      },
      "text-success": {
        "light": "#117b38",
        "dark": "#22c55e"
      },
      "text-warning": {
        "light": "#9d5604",
        "dark": "#f59e0b"
      },
      "text-danger": {
        "light": "#cd2121",
        "dark": "#d64b4b"
      },
      "palette-0": {
        "light": "#2563eb",
        "dark": "#3c74ed"
      },
      "palette-1": {
        "light": "#7c3aed",
        "dark": "#925bf0"
      },
      "palette-2": {
        "light": "#04825b",
        "dark": "#059669"
      },
      "palette-3": {
        "light": "#b16105",
        "dark": "#d97706"
      },
      "palette-4": {
        "light": "#dc2626",
        "dark": "#e03c3c"
      },
      "palette-5": {
        "light": "#0b7caf",
        "dark": "#0ea5e9"
      },
      "success-hover": {
        "light": "#117c38",
        "dark": "#2fc868"
      },
      "success-fg": {
        "light": "#ffffff",
        "dark": "#000000"
      },
      "info": {
        "light": "#0b7caf",
        "dark": "#0b7caf"
      },
      "info-hover": {
        "light": "#086193",
        "dark": "#086193"
      },
      "info-fg": {
        "light": "#ffffff",
        "dark": "#ffffff"
      }
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "full": "9999px"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px"
    },
    "font": {
      "sans": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
      "size-xs": "12px",
      "size-sm": "14px",
      "size-md": "16px",
      "size-lg": "18px",
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-bold": "600",
      "size-xl": "22px"
    },
    "shadow": {
      "sm": {
        "light": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
        "dark": "0 1px 2px 0 rgb(0 0 0 / 0.4)"
      },
      "md": {
        "light": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
        "dark": "0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.4)"
      },
      "lg": {
        "light": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
        "dark": "0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.4)"
      }
    },
    "transition": {
      "fast": "120ms ease",
      "base": "200ms ease",
      "slow": "300ms ease"
    },
    "ease": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "z": {
      "tooltip": "1000",
      "popover": "1500",
      "modal": "2000",
      "toast": "3000"
    },
    "control": {
      "height": "36px",
      "height-xs": "20px",
      "height-sm": "28px",
      "height-md": "36px",
      "height-lg": "44px",
      "height-xl": "52px"
    },
    "motion": {
      "shimmer": "1.6s",
      "sweep": "1.4s"
    }
  }
}
